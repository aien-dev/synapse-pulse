note synapse-pulse 10pulse.om: reconcile the claims ledger with GitHub and live omp sessions.
global gop ulong 16
global gopl ulong 16
global gfl ulong 8
global gnow ulong 2
global gco ulong 16384
global gcl ulong 16384
global gca uchar 1024
global gkd uchar 1024
global gcn ulong 1
global gtk uint 24576
global gtn ulong 1024
global grpo ulong 128
global grpl ulong 128
global grp uchar 128
global grn ulong 1
global gprr ulong 8192
global gprn ulong 8192
global gprs uchar 8192
global gprm uchar 8192
global gprho ulong 8192
global gprhl ulong 8192
global gprc ulong 1
global gcnt ulong 32
global gout uchar 4194304
global gon ulong 1
global gfp ulong 8
global gstop uint 32
global garr ulong 16
global gstopn ulong 1

text tusage "usage: synapse-pulse [--home DIR] run [--alert] [--alert-dir DIR] [--gh PATH] [--sessions DIR] [--claims-bin PATH] [--offline FIXTUREDIR] [--now YYYY-MM-DDTHH:MM:SSZ]"
text trun "run"
text thome "--home"
text talert "--alert"
text tadir "--alert-dir"
text tgh "--gh"
text tsess "--sessions"
text tcbin "--claims-bin"
text toff "--offline"
text tnow "--now"
text tenvh "AIEN_COORD_HOME="
text tenvhm "HOME="
text tdhome "/.local/state/aien-coord"
text tdadir "/home/drakestapleton/.local/state/aienos/watch"
text tdgh "/home/drakestapleton/.local/bin/gh"
text tdsess "/home/drakestapleton/.omp/agent/sessions"
text tnohome "synapse-pulse: no --home, AIEN_COORD_HOME or HOME"
text tnocbin "synapse-pulse: --claims-bin PATH is required (absolute path to synapse-claims)"
text tbadnow "synapse-pulse: --now must be YYYY-MM-DDTHH:MM:SSZ"
text tlist "list"
text tall "--all"
text tconf "conflicts"
text texpire "expire"
text tagent "--agent"
text tpulse "pulse"
text tslpu "/pulse"
text tsletag "/pulse/etags"
text tslfind "/pulse/findings.jsonl"
text tslreq "/pulse/requests.log"
text tsl "/"
text tetag ".etag"
text tbody ".body"
text thttp ".http"
text tenv "/usr/bin/env"
text tghome "HOME=/home/drakestapleton"
text tgpath "PATH=/home/drakestapleton/.local/bin:/usr/bin:/bin"
text tapi "api"
text tdi "-i"
text tdh "-H"
text tinm "If-None-Match: "
text tclfail "synapse-pulse: synapse-claims failed: "
text tclbad "synapse-pulse: malformed synapse-claims output line"
text tkid "id"
text tkagent "agent"
text tksess "session"
text tkkind "kind"
text tktarg "target"
text tkmode "mode"
text tkstate "state"
text tkint "intent"
text tkexp "expires"
text tkact "active"
text tksince "since"
text tka "a"
text tkb "b"
text tkreas "reason"
text tkop "op"
text tknum "number"
text tkmerg "merged_at"
text tkhead "head"
text tkref "ref"
text tkfile "filename"
text topen "open"
text tclosed "closed"
text tprepo "repo:"
text tpbr "branch:"
text tppath "path:"
text tppr "pr:"
text tpext "ext:"
text tmerged "MERGED"
text tdeploy "DEPLOYED"
text tjsonl ".jsonl"
text tpulls "/pulls?state=all&per_page=50"
text tfiles "/files?per_page=100"
text trepos "repos/"
text tpullsl "/pulls/"
text tqk "{\"kind\":\""
text tqsev "\",\"severity\":\""
text tqrepo "\",\"repo\":"
text tqtarg ",\"target\":"
text tqid ",\"id\":"
text tqagent ",\"agent\":"
text tqsess ",\"session\":"
text tqpr ",\"pr\":"
text tqpath ",\"path\":"
text tqoid ",\"other_id\":"
text tqoag ",\"other_agent\":"
text tqdet ",\"detail\":"
text tqend "}\n"
text tsevw "warn"
text tsevi "info"
text tseve "error"
text fexp "expired_lease"
text fdead "dead_session"
text funk "unknown_session"
text funcl "unclaimed_pr"
text fstat "status_contradicted"
text fdup "duplicate_work"
text fconf "conflict"
text tstops "with from into this that them they were been have will also make should would could than then when what which there their about after before over under only just more most some such each other being does done must need"
text tcap "synapse-pulse: GitHub request cap (40 per run) reached; skipped: "
text tghfail "synapse-pulse: GitHub read failed: "
text tbig "synapse-pulse: response over 983040 bytes, skipped: "
